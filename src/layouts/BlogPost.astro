---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_URL } from '../consts';
import { buildBlogGraph, showsProducts } from '../lib/schema';
import '../styles/apex.css';

type Props = CollectionEntry<'blog'>['data'] & {
	/** H2/H3 list from render(post) — drives the sidebar contents. */
	headings?: { depth: number; slug: string; text: string }[];
	/** True when the post embeds <PmsReport>, so the sidebar can prompt for it. */
	hasPmsWidget?: boolean;
};

const { title, description, pubDate, updatedDate, heroImage, heroAlt, faq, tags, vertical, vehicle, pms, featuredProducts, headings = [], hasPmsWidget = false } =
	Astro.props;

// Section-level only. H3s would turn a 14-section guide into a 40-line list
// that's harder to scan than the article itself.
const toc = headings.filter((h) => h.depth === 2);

// ── Structured data ────────────────────────────────────────────────────────
// The whole @graph is assembled by the shared engine in src/lib/schema.ts, which
// picks the entity mix from `vertical`. We only resolve the Astro-specific bits
// (absolute canonical URL + processed hero image path) and hand it plain data.
const siteHref = Astro.site?.href ?? `${SITE_URL}/`; // trailing slash (astro trailingSlash:'always')
const pageUrl = new URL(Astro.url.pathname, Astro.site).href; // canonical, trailing slash
const graph = buildBlogGraph({
	vertical,
	title,
	description,
	pageUrl,
	siteHref,
	imageUrl: heroImage ? new URL(heroImage.src, Astro.url).href : undefined,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate || pubDate).toISOString(),
	tags,
	faq,
	vehicle,
	pms,
	featuredProducts,
});

// Visible product section renders under the same rule the schema uses, so the
// cards and the ItemList markup can never disagree.
const showProducts = showsProducts(vertical) && !!(featuredProducts && featuredProducts.length);
---

<html lang="en-PH">
	<head>
		<BaseHead title={title} description={description} image={heroImage} ogType="article" />
		<!-- One linked @graph: Article + Vehicle + FAQPage (+ Products when present) -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
	</head>

	<body>
		<Header />
		<main>
			<article>
                <header class="blog-hero">
                    {heroImage && (
                        <div class="hero-bg-container">
                            {/* The hero IS the LCP element — it must not be lazy-loaded.
                                Astro's <Image> defaults to loading="lazy", which delays the
                                fetch until after layout and was costing ~6s LCP sitewide. */}
                            <Image width={1920} height={1080} src={heroImage} alt={heroAlt ?? ""} class="hero-bg-img" loading="eager" fetchpriority="high" decoding="sync" />
                            <div class="hero-overlay"></div>
                        </div>
                    )}
                    <div class="hero-content">
                        <div class="date">
                            {updatedDate && updatedDate.valueOf() !== pubDate.valueOf()
                                ? (<>Updated <FormattedDate date={updatedDate} /></>)
                                : (<FormattedDate date={pubDate} />)}
                        </div>
                        <h1>{title}</h1>
                        <p class="description">{description}</p>
                    </div>
                </header>
                
                <div class="layout-container">
                    {/* Desktop-only rail (hidden under 1024px). It previously held a
                        card that just restated the title; now it navigates. Anything
                        essential must stay in the article body, because most of our
                        readers are on phones and never see this column. */}
                    <aside class="sticky-toc">
                        {toc.length > 2 && (
                            <nav class="toc-card" aria-labelledby="toc-heading">
                                <h3 id="toc-heading">In This Guide</h3>
                                <ol>
                                    {toc.map((h) => (
                                        <li><a href={`#${h.slug}`}>{h.text}</a></li>
                                    ))}
                                </ol>
                            </nav>
                        )}

                        {hasPmsWidget && (
                            <div class="toc-prompt">
                                <p class="prompt-q">Magkano sa'yo?</p>
                                <p class="prompt-sub">Naka-PMS ka na? Share what you actually paid — anonymous, 10 seconds.</p>
                                <a class="prompt-cta" href="#share-what-you-paid">Share what you paid →</a>
                            </div>
                        )}
                    </aside>
                    
                    <div class="prose">
                        <slot />

                        {showProducts && (
                            <section class="products">
                                <h2>Recommended Parts & Upgrades</h2>
                                <p class="affiliate-disclosure">Some links below are affiliate links — we may earn a small commission at no extra cost to you. We only recommend parts we'd fit ourselves.</p>
                                <div class="product-grid">
                                    {featuredProducts.map((p) => (
                                        <a class="product-card" href={p.url} rel="sponsored nofollow noopener" target="_blank">
                                            {p.category && <span class="product-cat">{p.category}</span>}
                                            <h3>{p.name}</h3>
                                            {p.brand && <span class="product-brand">{p.brand}</span>}
                                            {p.description && <p>{p.description}</p>}
                                            <span class="product-cta">View part →</span>
                                        </a>
                                    ))}
                                </div>
                            </section>
                        )}

                        {faq && faq.length > 0 && (
                            <section class="faq">
                                <h2>Frequently Asked Questions</h2>
                                {faq.map((item) => (
                                    <details class="faq-item">
                                        <summary>{item.q}</summary>
                                        <p>{item.a}</p>
                                    </details>
                                ))}
                            </section>
                        )}

                        <div class="author-block">
                            <h3>About the Author</h3>
                            <p>Expert automotive content by Apex Engine Editorial Team. Last updated: <FormattedDate date={updatedDate || pubDate} /></p>
                        </div>
                    </div>
                </div>

                <script>
                    // Highlights the sidebar entry for the section being read.
                    // Guarded on the rail existing: it's display:none under
                    // 1024px, so on phones this observer never gets built.
                    const rail = document.querySelector('.toc-card');
                    if (rail && window.matchMedia('(min-width: 1024px)').matches) {
                        const links = new Map<string, HTMLAnchorElement>();
                        rail.querySelectorAll('a[href^="#"]').forEach((a) => {
                            const el = a as HTMLAnchorElement;
                            links.set(decodeURIComponent(el.hash.slice(1)), el);
                        });

                        const seen = new Set<string>();
                        const observer = new IntersectionObserver(
                            (entries) => {
                                for (const entry of entries) {
                                    if (entry.isIntersecting) seen.add(entry.target.id);
                                    else seen.delete(entry.target.id);
                                }
                                // Mark the topmost visible section, so scrolling
                                // past a short heading doesn't leave two active.
                                let active: string | null = null;
                                for (const id of links.keys()) {
                                    if (seen.has(id)) { active = id; break; }
                                }
                                links.forEach((link, id) => link.classList.toggle('is-active', id === active));
                            },
                            // Bias toward the upper third: a heading is "current"
                            // once it reaches reading position, not when it first
                            // peeks in at the bottom of the viewport.
                            { rootMargin: '-80px 0px -66% 0px' },
                        );

                        links.forEach((_, id) => {
                            const target = document.getElementById(id);
                            if (target) observer.observe(target);
                        });
                    }
                </script>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
    /* --- Hero Section --- */
    .blog-hero {
        position: relative;
        min-height: 50vh;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--paper);
        text-align: center;
        padding: 4em 1em;
        margin-bottom: 3em;
        background: var(--black-mica);
        overflow: hidden;
    }
    .hero-bg-container {
        position: absolute;
        inset: 0;
        z-index: 0;
    }
    .hero-bg-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.3;
        filter: grayscale(100%) brightness(0.8);
    }
    .hero-overlay {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at center, transparent, var(--black-mica));
    }
    .hero-content {
        position: relative;
        z-index: 1;
        max-width: 1000px;
        padding: 0 1.5em;
    }
    .blog-hero h1 {
        color: var(--paper);
        font-size: clamp(2.5rem, 8vw, 4.5rem);
        line-height: 0.95;
        margin: 0.2em 0 0.3em;
        text-transform: uppercase;
        font-weight: 900;
        letter-spacing: -0.05em;
    }
    .blog-hero .description {
        font-size: clamp(1.1rem, 3vw, 1.4rem);
        color: var(--metal-gray-light);
        max-width: 50ch;
        margin: 0 auto;
        line-height: 1.4;
    }
    .blog-hero .date {
        color: var(--red-mica);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-size: 0.9rem;
    }

    /* --- Body Content --- */
    .layout-container {
        display: grid;
        grid-template-columns: 1fr;
        gap: 3em;
        max-width: 1200px;
        margin: 0 auto 5em;
        padding: 0 1.5em;
        /* Drives the <Figure width="full"> breakout. On mobile there's no
           sidebar, so "full" reaches the container padding edges. */
        --bleed-left: 1.5em;
        --bleed-right: 1.5em;
    }
    @media (min-width: 1024px) {
        .layout-container {
            grid-template-columns: 280px 1fr;
            /* Reclaim the 280px TOC sidebar + 3em gap on the left so a full-width
               figure spans the whole content row. */
            --bleed-left: calc(280px + 3em);
            --bleed-right: 0px;
        }
    }

    .sticky-toc {
        display: none;
    }
    @media (min-width: 1024px) {
        .sticky-toc {
            display: block;
            position: sticky;
            top: 2em;
            height: fit-content;
        }
    }
    .toc-card {
        background: var(--paper-off);
        border-left: 4px solid var(--red-mica);
        padding: 1.5em;
        /* A 14-section guide would otherwise push the prompt below the fold on
           a laptop. Cap the list and let it scroll inside the sticky rail. */
        max-height: calc(100vh - 14em);
        overflow-y: auto;
    }
    .toc-card h3 {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 1em;
    }
    .toc-card ol {
        list-style: none;
        padding: 0;
        margin: 0;
        counter-reset: toc;
    }
    .toc-card li {
        counter-increment: toc;
        margin-bottom: 0.55em;
        line-height: 1.35;
    }
    .toc-card li::before {
        content: counter(toc);
        color: var(--metal-gray-light);
        font-size: 0.72rem;
        font-weight: 700;
        margin-right: 0.6em;
    }
    .toc-card a {
        font-size: 0.83rem;
        color: var(--metal-gray);
        text-decoration: none;
        border-bottom: 1px solid transparent;
    }
    .toc-card a:hover,
    .toc-card a.is-active {
        color: var(--black-mica-2);
        border-bottom-color: var(--red-mica);
    }
    .toc-card a.is-active {
        font-weight: 700;
    }

    /* Jump targets shouldn't land flush against the viewport edge. */
    .prose :global(h2),
    .prose :global(#share-what-you-paid) {
        scroll-margin-top: 2rem;
    }

    .toc-prompt {
        margin-top: 1.25em;
        padding: 1.25em;
        background: var(--black-mica-2, #111827);
        color: var(--paper, #fff);
    }
    .prompt-q {
        font-size: 1rem;
        font-weight: 700;
        margin: 0 0 0.4em;
    }
    .prompt-sub {
        font-size: 0.8rem;
        line-height: 1.45;
        opacity: 0.75;
        margin: 0 0 0.9em;
    }
    .prompt-cta {
        display: inline-block;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--paper, #fff);
        background: var(--red-mica);
        padding: 0.6em 1em;
        text-decoration: none;
    }
    .prompt-cta:hover {
        background: var(--red-mica-dark, #B91C1C);
    }

    .prose {
        font-size: 1.125rem;
        line-height: 1.7;
        color: var(--black-mica-2);
    }
    
    /* Rhythm for sections - targeting subheadings */
    :global(.prose h2) {
        font-size: 2rem;
        margin-top: 2.5em;
        padding-top: 1em;
        border-top: 1px solid var(--line);
        display: flex;
        align-items: baseline;
        gap: 0.5em;
    }
    :global(.prose h2::before) {
        content: "/";
        color: var(--red-mica);
        font-weight: 900;
    }

    :global(.prose p) {
        margin-bottom: 1.5em;
    }

    /* Base styling for content authored as plain markdown (images, lists,
       links, rules, quotes). The editorial components override these as needed. */
    :global(.prose img) {
        max-width: 100%;
        height: auto;
        display: block;
    }
    :global(.prose figure) {
        margin: 2.5em 0;
    }
    :global(.prose figcaption) {
        margin-top: 0.5em;
        font-size: 0.85rem;
        color: var(--metal-gray);
    }
    :global(.prose ul),
    :global(.prose ol) {
        margin: 0 0 1.5em;
        padding-left: 1.25em;
        line-height: 1.7;
    }
    :global(.prose li) {
        margin-bottom: 0.5em;
    }
    :global(.prose a) {
        color: var(--red-mica);
        text-decoration: underline;
        text-underline-offset: 2px;
    }
    :global(.prose hr) {
        border: none;
        border-top: 1px solid var(--line);
        margin: 3em 0;
    }
    :global(.prose blockquote) {
        margin: 2em 0;
        padding-left: 1.25em;
        border-left: 4px solid var(--line);
        color: var(--metal-gray);
        font-style: italic;
    }

    .author-block {
        border-top: 4px solid var(--black-mica);
        background: var(--paper-off);
        margin-top: 4em;
        padding: 2em;
    }
    .author-block h3 {
        font-size: 1.1rem;
        margin-bottom: 0.5em;
    }
    .author-block p {
        margin: 0;
        font-size: 0.95rem;
        color: var(--metal-gray);
    }

    /* Recommended products — visible cards paired with ItemList/Product schema.
       Both render from the same `featuredProducts` frontmatter, so schema never
       describes a product the reader can't see. */
    .products {
        margin-top: 3em;
        border-top: 4px solid var(--black-mica);
        padding-top: 1.5em;
    }
    .products h2 {
        font-size: 1.5rem;
        text-transform: uppercase;
        margin-bottom: 0.5em;
    }
    .affiliate-disclosure {
        font-size: 0.85rem;
        color: var(--metal-gray);
        margin-bottom: 1.5em;
    }
    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1em;
    }
    .product-card {
        display: flex;
        flex-direction: column;
        gap: 0.35em;
        background: var(--paper-off);
        border-left: 4px solid var(--red-mica);
        padding: 1.25em;
        text-decoration: none;
        color: var(--black-mica-2);
        transition: transform 0.15s ease;
    }
    .product-card:hover {
        transform: translateY(-2px);
    }
    .product-card h3 {
        font-size: 1.05rem;
        margin: 0;
    }
    .product-cat {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--red-mica);
        font-weight: 700;
    }
    .product-brand {
        font-size: 0.85rem;
        color: var(--metal-gray);
    }
    .product-card p {
        font-size: 0.9rem;
        margin: 0.25em 0 0;
    }
    .product-cta {
        margin-top: auto;
        padding-top: 0.5em;
        font-weight: 700;
        color: var(--red-mica);
    }

    /* FAQ — visible Q&A, paired with FAQPage schema for AI Overviews */
    .faq {
        margin-top: 3em;
        border-top: 4px solid var(--black-mica);
        padding-top: 1.5em;
    }
    .faq h2 {
        font-size: 1.5rem;
        text-transform: uppercase;
        margin-bottom: 0.75em;
    }
    .faq-item {
        border-bottom: 1px solid var(--line);
        padding: 0.75em 0;
    }
    .faq-item summary {
        cursor: pointer;
        font-weight: 700;
        list-style-position: inside;
    }
    .faq-item summary:hover {
        color: var(--accent-color);
    }
    .faq-item p {
        margin: 0.6em 0 0;
        color: var(--black-mica-2);
    }

    /* Data-friendly table styling */
    :global(.prose table) {
        width: 100%;
        border-collapse: collapse;
        margin: 2em 0;
    }
    :global(.prose th) {
        background-color: var(--text-color);
        color: var(--bg-color);
        padding: 0.75em;
        text-align: left;
    }
    :global(.prose td) {
        border: 1px solid #E5E5E5;
        padding: 0.75em;
    }
</style>
